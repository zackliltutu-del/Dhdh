local function getOrbitPosition(targetHrp, myHrp, angle)
    if not targetHrp or not myHrp then return nil end
    local dirToMe = (myHrp.Position - targetHrp.Position).Unit
    local right = dirToMe:Cross(Vector3.new(0,1,0)).Unit
    if right.Magnitude < 0.01 then right = Vector3.new(1,0,0) end
    local offset = right * math.cos(angle) * orbitRadius + Vector3.new(0,1,0) * math.sin(angle) * (orbitRadius * 0.5)
    return targetHrp.Position + offset
end

