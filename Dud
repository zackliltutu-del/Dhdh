        hl.FillColor = dc; hl.OutlineColor = dc; nl.TextColor3 = dc; ac.BackgroundColor3 = dc
    end)
end
local function removeESPForPlayer(player)
    local d = espBillboards[player]
    if d then
        pcall(function() if d.Connection then d.Connection:Disconnect() end end)
        pcall(function() if d.Highlight then d.Highlight:Destroy() end end)
        pcall(function() if d.Billboard then d.Billboard:Destroy() end end)
        espBillboards[player] = nil
    end
end
local function refreshAllESP()
    if not espEnabled then
        for p in pairs(espBillboards) do removeESPForPlayer(p) end
        return
    end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local d = espBillboards[p]
            local changed = p.Character and d and d.Billboard and d.Billboard.Adornee ~= p.Character:FindFirstChild("HumanoidRootPart")
            if not d or changed then createESPForPlayer(p) end
        end
    end
    for p in pairs(espBillboards) do if not p or not p.Parent then removeESPForPlayer(p) end end
end
local function setupPlayerCharacterWatcher(player)
    if espCharacterAddedConnections[player] then espCharacterAddedConnections[player]:Disconnect() end
    espCharacterAddedConnections[player] = player.CharacterAdded:Connect(function()
        task.wait(0.3); if espEnabled then createESPForPlayer(player) end
    end)
end
task.spawn(function()
    while espScanning do if espEnabled then refreshAllESP() end task.wait(0.2) end
end)
Players.PlayerAdded:Connect(function(p) task.wait(0.5); if espEnabled then setupPlayerCharacterWatcher(p); createESPForPlayer(p) end end)
Players.PlayerRemoving:Connect(function(p) removeESPForPlayer(p); if espCharacterAddedConnections[p] then pcall(function() espCharacterAddedConnections[p]:Disconnect() end); espCharacterAddedConnections[p] = nil end end)

local function teleportToPlayer(target)
    if not target or not target.Character or target.Name == OWNER_NAME then return end
    local tr = target.Character:FindFirstChild("HumanoidRootPart")
    if not tr then return end
    local mr = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if mr then mr.CFrame = CFrame.new(tr.Position) end
end

local function startBow()
    if bowEnabled then return end
    bowEnabled = true
    task.spawn(function()
        while bowEnabled do
            local t = getNearestTarget()
            if t and AttackRemote then
                for i = 1, 3 do
                    pcall(function() AttackRemote:InvokeServer(t, State.attackIndex) end)
                    State.attackIndex = State.attackIndex == 1 and 2 or 1
                    task.wait(1/bowShotsPerSec)
                end
            end
            task.wait(1/bowShotsPerSec)
        end
    end)
end
local function stopBow() bowEnabled = false end

