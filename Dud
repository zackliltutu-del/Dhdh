local function updateFlight()
    if not State.flying then return end
    local c = LocalPlayer.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    local hum = c and c:FindFirstChild("Humanoid")
    if not root or not hum then return end
    hum:ChangeState(Enum.HumanoidStateType.Physics)
    local md = hum.MoveDirection
    if md.Magnitude > 0 then
        local camCF = Camera.CFrame
        local lm = camCF:VectorToObjectSpace(md)
        local worldMove = (camCF.LookVector * -lm.Z) + (camCF.RightVector * lm.X)
        if State.flyBodyVelocity then State.flyBodyVelocity.Velocity = worldMove.Unit * State.flySpeed end
    else
        if State.flyBodyVelocity then State.flyBodyVelocity.Velocity = Vector3.zero end
    end
    if State.flyBodyGyro then State.flyBodyGyro.CFrame = Camera.CFrame end
end

