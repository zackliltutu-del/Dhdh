local function renderPlayersTab()
    for _, child in pairs(Tabs["Players"]:GetChildren()) do
        if child:IsA("Frame") and child ~= PlayersHeader and child.Size.Y.Offset == 40 then child:Destroy() end
    end
    local i = 1
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local isOwner = p.Name == OWNER_NAME
            local row = create("Frame", {Size = UDim2.new(1,0,0,40), BackgroundColor3 = Theme.Secondary, Parent = Tabs["Players"]})
            corner(row, 6)
            create("TextLabel", {Size = UDim2.new(0.08,0,1,0), BackgroundTransparency = 1, Text = tostring(i), Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Theme.SubText, Parent = row})
            create("TextLabel", {Size = UDim2.new(0.30,0,1,0), Position = UDim2.new(0.08,0,0,0), BackgroundTransparency = 1, Text = isOwner and "👑 " .. p.Name or p.Name, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = isOwner and Color3.fromRGB(255,215,0) or Theme.Text, TextXAlignment = Enum.TextXAlignment.Center, Parent = row})
            local function dyn(x, init, role)
                local isProt = protectedPlayers[p.Name] == true
                local isAtt = State.attachedToPlayer == p
                local mode = playerAttackTypes[p.Name] or "Normal"
                local txt, bg
                if role == "Mode" then txt = mode; bg = mode == "Orbit" and Color3.fromRGB(150,50,255) or Theme.Accent
                elseif role == "Protect" then txt = isProt and "Protected" or init; bg = isProt and Theme.Green or Theme.Accent
                elseif role == "Attach" then txt = isAtt and "Attached" or init; bg = isAtt and Theme.Red or Theme.Accent
                else txt = init; bg = Theme.Accent end
                if isOwner and role ~= "TP" then txt = role == "Protect" and "👑" or "X"; bg = Color3.fromRGB(80,80,80) end
                local b = create("TextButton", {Size = UDim2.new(0.15,-8,0,26), Position = UDim2.new(x,4,0.5,-13), BackgroundColor3 = bg, Text = txt, Font = Enum.Font.GothamBold, TextSize = 9, TextColor3 = Color3.new(1,1,1), Parent = row})
                corner(b, 6)
                b.MouseButton1Click:Connect(function()
                    if isOwner and role ~= "TP" then return end
                    if role == "Mode" then
                        if (playerAttackTypes[p.Name] or "Normal") == "Normal" then
                            playerAttackTypes[p.Name] = "Orbit"; b.Text = "Orbit"; b.BackgroundColor3 = Color3.fromRGB(150,50,255)
                        else
                            playerAttackTypes[p.Name] = "Normal"; b.Text = "Normal"; b.BackgroundColor3 = Theme.Accent
                        end
                    elseif role == "Protect" then
                        if protectedPlayers[p.Name] then protectedPlayers[p.Name] = nil; b.Text = init; b.BackgroundColor3 = Theme.Accent
                        else protectedPlayers[p.Name] = true; b.Text = "Protected"; b.BackgroundColor3 = Theme.Green end
                        refreshAllESP()
                    elseif role == "Attach" then
                        if State.attachedToPlayer == p then State.attachedToPlayer = nil; b.Text = init; b.BackgroundColor3 = Theme.Accent
                        else State.attachedToPlayer = p; b.Text = "Attached"; b.BackgroundColor3 = Theme.Red end
                    elseif role == "TP" then
                        teleportToPlayer(p)
                    end
                end)
            end
            dyn(0.38, "Normal", "Mode")
            dyn(0.53, "Protect", "Protect")
            dyn(0.68, "Attach", "Attach")
            dyn(0.83, "TP", "TP")
            i = i + 1
        end
    end
end
