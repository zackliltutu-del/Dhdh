local function hopMost()
    pcall(function()
        local r = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
        if r and r.data then
            local best = r.data[1]
            for _, s in ipairs(r.data) do if s.playing > best.playing then best = s end end
            if best.id ~= game.JobId then TeleportService:TeleportToPlaceInstance(game.PlaceId, best.id, LocalPlayer) end
        end
    end)
end
